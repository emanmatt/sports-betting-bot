# ════════════════════════════════════════════════════════
#  SPORTS BETTING BOT — ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in your keys
#  NEVER commit .env to GitHub
# ════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/sportsbetting
REDIS_URL=redis://localhost:6379

# ── Odds API ($50/mo) ──────────────────────────────────
# Sign up at: https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# ── Reddit API (Free) ──────────────────────────────────
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=SportsBettingBot/1.0

# ── X / Twitter (Optional — start free) ────────────────
# Sign up at: https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ── AI Analysis ────────────────────────────────────────
# Sign up at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key
# Defaults to explainable local rules when no provider/key is enabled.
AI_PROVIDER=heuristic
AI_MODEL=claude-3-5-haiku-latest
# Optional X v2 recent-search filter appended to every query.
X_SEARCH_QUERY_SUFFIX=-is:retweet lang:en
# Discovery guardrails. Do not lower without backtesting.
MIN_EDGE_PROBABILITY=0.54
MONTE_CARLO_SIMS=20000

# ── Pinecone Vector DB (Free tier available) ───────────
# Sign up at: https://pinecone.io
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment

# ── App Settings ───────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
